<?xml version="1.0" encoding="utf-8"?>
<!-- Conversations can be share targets: the system's share sheet lists recent ones (ui/share/Share.kt). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="fish.nexa.MainActivity">
        <data android:mimeType="*/*" />
        <category android:name="fish.nexa.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
