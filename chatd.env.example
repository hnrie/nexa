# chatd configuration. Copy to chatd.env (chmod 600). Every key is optional;
# the value shown is the default. Environment variables override this file.

# Address to listen on. Keep it on loopback: the Cloudflare tunnel dials it.
LISTEN=127.0.0.1:8090

# Public origin the app is reached at. Used for WebSocket origin checks and links.
PUBLIC_URL=https://nexa.fish

# Other addresses the same Nexa answers at, comma-separated, each working in
# full (its own sign-ins, its own captcha domain in Cloudflare Turnstile).
ALT_URLS=

# Addresses Nexa used to be at, comma-separated. They keep working for the
# desktop apps installed before the move and for webhooks that still call
# them, while a browser that opens one is moved on to PUBLIC_URL, signed in.
MOVED_FROM=

# Where the database (chat.db) and blobs/ live. Relative to the working directory.
DATA_DIR=./data
# Published desktop app installers and update manifests, served at /desktop/
# (make publish-desktop fills it). Defaults to DATA_DIR/desktop.
#DESKTOP_DIR=./data/desktop

# The built web app (make web).
WEB_DIST=./web/dist

# Upload caps in bytes. Files bigger than Cloudflare's 100 MB request limit are
# sent in pieces, so MAX_UPLOAD_BYTES may be raised past it.
MAX_UPLOAD_BYTES=104857600
MAX_AVATAR_BYTES=10485760
MAX_EMOJI_BYTES=2097152
MAX_STICKER_BYTES=5242880

# open: anyone can register. invite: registration needs REGISTRATION_KEY. closed: nobody.
REGISTRATION=open
REGISTRATION_KEY=

# This username gets admin rights (the first account ever created does too).
ADMIN_USERNAME=

# Optional TURN relay for calls that fail direct connection (e.g. Cloudflare TURN).
# Comma-separated URLs, e.g. turn:turn.cloudflare.com:3478?transport=udp,turns:turn.cloudflare.com:5349
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional Cloudflare Realtime TURN key (id + API token), used instead of the static credentials above.
TURN_KEY_ID=
TURN_API_TOKEN=

# Optional STUN servers, comma-separated, or "none". Defaults to Cloudflare's and Google's.
STUN_URLS=

# Where the requests a person can point this server at go out: link previews,
# the media proxy (pictures and videos linked from elsewhere) and the YouTube
# player. The sites they name see that proxy's address, never this server's.
#   warp           Cloudflare WARP's local SOCKS5 proxy. chatd puts WARP in proxy
#                  mode on WARP_PROXY_PORT and keeps it connected; the rest of the
#                  machine's traffic is left alone. deploy/warp-proxy.sh installs
#                  WARP on Linux or macOS (make run does it for you).
#   socks5://h:p   any other SOCKS5 proxy
#   off            straight out, showing this server's address (tests only)
# With the proxy down these requests fail; they never fall back to going direct.
EGRESS_PROXY=warp
WARP_PROXY_PORT=40000

# Optional Klipy key to enable GIF search in the picker (free at klipy.com).
KLIPY_API_KEY=

# Optional Telegram bot token to enable Telegram sticker pack imports
# (Settings → Expression Packs → Create → Import Telegram Sticker Pack).
# The token never leaves this server: clients only ever send a pack link.
TELEGRAM_BOT_TOKEN=

# Optional Discord activity sync: people link their Discord account in
# Settings → Activity, and what Discord says they are doing (a song, a game,
# a stream) shows as their activity here. Needs a Discord application with a
# bot that sits in a Discord server made for this. In the Developer Portal:
# Bot → Privileged Gateway Intents → Presence Intent and Server Members Intent
# on, and OAuth2 → Redirects → <PUBLIC_URL>/api/v1/connections/discord/callback.
# The bot needs Create Instant Invite (Administrator covers it) in that server.
# All three of the first values, or it stays off. Keep them secret.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# The Discord server the bot watches presence in. Empty: the bot's only server.
DISCORD_ACTIVITY_GUILD_ID=
# The redirect listed in the Developer Portal, when it is not the one under
# PUBLIC_URL (after a move, say). People still come back to the address they
# started from.
DISCORD_REDIRECT_URL=

# Optional Cloudflare Realtime SFU (free up to 1,000 GB a month): every call goes
# through Cloudflare, so nobody in a call learns another person's IP address, and
# frames stay end-to-end encrypted. Set both to turn it on. Video pauses near the
# monthly allowance and calls stop just short of it, so nothing is ever billed.
REALTIME_APP_ID=
REALTIME_APP_SECRET=
REALTIME_MONTHLY_GB=1000
# Guest links let people without an account into a call. They only work when calls
# go through the SFU above, where the link carries the call's key. Peer to peer, a
# link's code alone would let someone hear the call and guests would see members'
# addresses; set this to 1 to allow them anyway (development and tests).
GUEST_LINKS_P2P=

# Optional Cloudflare Turnstile captchas (free) on sign-up, login, account recovery,
# friend requests, and creating or joining servers. Set both keys to turn them on.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sessions expire after this many days without use (at most 36500).
SESSION_TTL_DAYS=90

# debug | info | warn | error
LOG_LEVEL=info
# Empty writes the log to stdout, which systemd's journal keeps and rotates.
# A path makes chatd write it there itself, starting a new file past 10 MB and
# keeping five old ones beside it (chatd.log.1 … .5); the macOS LaunchDaemon
# sets this, since launchd never rotates what it appends stdout to.
#LOG_FILE=./logs/chatd.log

# The database. Empty keeps the SQLite file in DATA_DIR, which is what one
# machine wants. A postgres:// URL moves it to Postgres, for a replica or a
# database somebody else keeps alive (still with one chatd process, see
# REDIS_URL). Move an existing one across with
# `chatmigrate --from data/chat.db --to '<url>'` while chatd is stopped.
DATABASE_URL=
# Rate limits kept in Redis, so a restart does not reset them. Empty keeps them
# in this process. This is not a way to run several chatd processes as one
# Nexa — events, presence and calls stay in the process holding the
# sockets — so run one. A URL that cannot be reached stops chatd.
REDIS_URL=
# Leave this at 0. It tells processes sharing a database apart in the ids
# they hand out (0–1023), but chatd runs as a single process, so it
# warns at startup when this is set.
NODE_ID=0
